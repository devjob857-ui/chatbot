# Plantilla de variables de entorno de Medicalidad AI.
# Copiar a .env y ajustar los valores:  cp .env.example .env
# Nunca subir .env al repositorio.

# --- Modelo local (Ollama) ---
# URL del servidor Ollama. Por defecto, el de la máquina local.
OLLAMA_BASE_URL=http://localhost:11434
# Modelo de chat. Descargarlo antes con: ollama pull llama3.2:3b
LLM_MODEL=llama3.2:3b

# --- Base de datos MariaDB (solo lectura) ---
# Usar un usuario con permiso SELECT únicamente.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- API ---
# Orígenes permitidos por CORS, en formato JSON. Vacío = sin CORS
# (la UI se sirve desde el mismo origen).
# Ejemplo: CORS_ORIGINS=["http://localhost:3000"]
CORS_ORIGINS=[]
